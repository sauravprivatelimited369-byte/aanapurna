# PLACEHOLDER NAMES ONLY. Copy nothing from here into a commit.
# Enter the real values in your host's secure "Environment variables" / "Secrets" settings.
# Every value below is a placeholder, not a working credential.

# --- PostgreSQL (a persistent managed database, not GitHub) ---
# Four separate least-privilege connection URLs. Generate a database, roles and
# passwords with your provider, then apply: npm run db:migrate
DATABASE_URL=REPLACE_WITH_APP_ROLE_POSTGRES_URL
AUTH_DATABASE_URL=REPLACE_WITH_AUTH_ROLE_POSTGRES_URL
WORKER_DATABASE_URL=REPLACE_WITH_WORKER_ROLE_POSTGRES_URL
MIGRATION_DATABASE_URL=REPLACE_WITH_MIGRATOR_ROLE_POSTGRES_URL
DATABASE_SSL=true
DB_POOL_MAX=10
AUTH_DB_POOL_MAX=5

# --- Authentication and encryption secrets ---
# Generate independently with: openssl rand -base64 48  /  openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
OTP_HASH_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
OTP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY

# --- Public application URL (must match the HTTPS origin users open) ---
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN

# --- Real verification / password-reset email delivery ---
# Use ONE of the two SMTP forms below. SMTP_URL may contain the provider's
# username and password; put it ONLY in the secure deployment settings.
SMTP_FROM="Annapurna Link <no-reply@REPLACE_WITH_YOUR_DOMAIN>"
SMTP_URL=REPLACE_WITH_SMTP_URL_INCLUDING_CREDENTIALS
# Alternative explicit settings (leave SMTP_URL empty if you use these):
# SMTP_HOST=REPLACE_WITH_SMTP_HOST
# SMTP_PORT=587
# SMTP_USER=REPLACE_WITH_SMTP_USERNAME
# SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SMTP_SECURE=false

# --- Launch gate ---
# Keep false until the food-safety, legal, privacy and security approvals are recorded.
OPERATIONS_ENABLED=false
FILE_SCAN_MODE=disabled
