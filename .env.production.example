# PLACEHOLDER NAMES ONLY. Copy nothing from here into a commit.
# Enter the real values in your host's secure "Environment variables" / "Secrets" settings.
# Every value below is a placeholder, not a working credential.

# --- Choose ONE database mode ---

# Mode A — managed PostgreSQL (Supabase Postgres, or another host) used as a
# plain PostgreSQL database. Supabase Auth is NOT used; Better Auth remains the
# app's only authentication system. For Docker Compose also apply
# docker-compose.managed-db.yml. For Vercel, set these four names as encrypted
# project environment variables.
# Uncomment these four lines and replace them with four least-privilege role URLs.
# DATABASE_URL=REPLACE_WITH_APP_ROLE_POSTGRES_URL
# AUTH_DATABASE_URL=REPLACE_WITH_AUTH_ROLE_POSTGRES_URL
# WORKER_DATABASE_URL=REPLACE_WITH_WORKER_ROLE_POSTGRES_URL
# MIGRATION_DATABASE_URL=REPLACE_WITH_MIGRATOR_ROLE_POSTGRES_URL
# DATABASE_SSL=true
# DB_POOL_MAX=5
# AUTH_DB_POOL_MAX=3
# On IPv4-only hosts (for example Vercel), Supabase's direct db.<ref>.supabase.co
# endpoint is IPv6-only. Keep the four encrypted direct role URLs above and set
# these plain, non-secret values; the app rewrites them at runtime to Supabase's
# shared session pooler (role.<ref>@pooler-host:5432). Copy the pooler host from
# the Supabase Connect dialog; do not invent the cluster index.
# DATABASE_URL_REWRITE_TO_POOLER=true
# SUPABASE_POOLER_HOST=REPLACE_WITH_SESSION_POOLER_HOST
# SUPABASE_PROJECT_REF=REPLACE_WITH_PROJECT_REF
# DATABASE_POOLER_PORT=5432
# DATABASE_CONNECT_TIMEOUT_MS=30000
# The public Supabase Root 2021 CA is already bundled and pinned in the code;
# do not set rejectUnauthorized=false or NODE_TLS_REJECT_UNAUTHORIZED=0.

# Mode B — included single-host Docker Compose stack. Use
# docker-compose.yml + docker-compose.production.yml only; Compose builds the
# four least-privilege URLs from these independent passwords. Do not reuse any value.
POSTGRES_DB=annapurna_link
POSTGRES_USER=annapurna_migrator
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_OWNER_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_ROLE_PASSWORD
AUTH_DB_PASSWORD=REPLACE_WITH_RANDOM_AUTH_ROLE_PASSWORD
WORKER_DB_PASSWORD=REPLACE_WITH_RANDOM_WORKER_ROLE_PASSWORD
DATABASE_SSL=false

# --- Authentication and encryption secrets ---
# Generate independently with: openssl rand -base64 48  /  openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
OTP_HASH_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
OTP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY

# --- Public HTTPS origin (must match the domain users open) ---
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN
# Required by the included Caddy HTTPS proxy; on Vercel use the project alias.
APP_DOMAIN=REPLACE_WITH_YOUR_DOMAIN
# Vercel injects VERCEL_URL automatically for preview hosts. Do not set it here.

# --- Real verification / password-reset email delivery ---
# Use ONE of the two SMTP forms below. SMTP_URL may contain the provider's
# username and password; put it ONLY in the secure deployment settings.
SMTP_FROM="Annapurna Link <no-reply@REPLACE_WITH_YOUR_DOMAIN>"
# SMTP_URL=REPLACE_WITH_SMTP_URL_INCLUDING_CREDENTIALS
# Alternative explicit settings (leave SMTP_URL empty if you use these):
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
# Gmail/Workspace example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true and a 16-character App Password in SMTP_PASS.
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_SECURE=true

# --- Launch gate ---
# Keep false until the food-safety, legal, privacy and security approvals are recorded.
OPERATIONS_ENABLED=false
FILE_SCAN_MODE=disabled

# Synthetic CI/unit checks only. Never set this in a real deployment.
# ALLOW_TEST_DOMAINS=true
