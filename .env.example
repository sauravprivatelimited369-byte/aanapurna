# Copy-safe template only. Generate private local values with: node scripts/create-local-env.mjs
POSTGRES_DB=annapurna_link
POSTGRES_USER=annapurna_migrator
POSTGRES_PORT=5432
POSTGRES_PASSWORD=GENERATED_BY_SCRIPT
APP_DB_PASSWORD=GENERATED_BY_SCRIPT
AUTH_DB_PASSWORD=GENERATED_BY_SCRIPT
WORKER_DB_PASSWORD=GENERATED_BY_SCRIPT

# These URLs are for running npm scripts on the host. Compose replaces them with internal service URLs.
DATABASE_URL=postgres://annapurna_app:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
AUTH_DATABASE_URL=postgres://annapurna_auth:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
WORKER_DATABASE_URL=postgres://annapurna_worker:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
MIGRATION_DATABASE_URL=postgres://annapurna_migrator:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link

AUTH_SECRET=GENERATED_BY_SCRIPT
OTP_HASH_KEY=GENERATED_BY_SCRIPT
OTP_ENCRYPTION_KEY=GENERATED_BY_SCRIPT
EMAIL_ENCRYPTION_KEY=GENERATED_BY_SCRIPT

APP_URL=http://localhost:3000
APP_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_URL=smtp://mailpit:1025
SMTP_FROM="Annapurna Link <no-reply@annapurna.local>"
# Production SMTP can instead use these names; never put real credentials in this file.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
DATABASE_SSL=false
OPERATIONS_ENABLED=false
FILE_SCAN_MODE=disabled
