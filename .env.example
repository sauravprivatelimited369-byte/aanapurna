# Copy-safe template only. Generate private local values with: node scripts/create-local-env.mjs
POSTGRES_DB=annapurna_link
POSTGRES_USER=annapurna_migrator
POSTGRES_PORT=5432
POSTGRES_PASSWORD=GENERATED_BY_SCRIPT
APP_DB_PASSWORD=GENERATED_BY_SCRIPT
AUTH_DB_PASSWORD=GENERATED_BY_SCRIPT
WORKER_DB_PASSWORD=GENERATED_BY_SCRIPT

# These URLs are for running npm scripts on the host. Compose replaces them with internal service URLs.
DATABASE_URL=postgres://annapurna_app:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
AUTH_DATABASE_URL=postgres://annapurna_auth:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
WORKER_DATABASE_URL=postgres://annapurna_worker:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link
MIGRATION_DATABASE_URL=postgres://annapurna_migrator:GENERATED_BY_SCRIPT@127.0.0.1:5432/annapurna_link

AUTH_SECRET=GENERATED_BY_SCRIPT
OTP_HASH_KEY=GENERATED_BY_SCRIPT
OTP_ENCRYPTION_KEY=GENERATED_BY_SCRIPT
EMAIL_ENCRYPTION_KEY=GENERATED_BY_SCRIPT

APP_URL=http://localhost:3000
APP_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_URL=smtp://mailpit:1025
SMTP_FROM="Annapurna Link <no-reply@annapurna.local>"
# Production SMTP can instead use these names; never put real credentials in this file.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Notifications to the device a person is holding (Web Push). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these, push is simply off: the interface says so and no device can be registered.
# The private key is a credential; it never leaves the server and never enters the browser.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@example.org
DATABASE_SSL=false
OPERATIONS_ENABLED=false
FILE_SCAN_MODE=disabled
# Point this at a reachable clamd and set FILE_SCAN_MODE=clamav to accept uploads at all.
# `docker compose --profile scanner up -d` provides one on the private network as `clamd`.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Optional. Backlog sweep: minutes before an unclaimed delivery is escalated to
# operations (default 30), and days before partner evidence expiry is escalated
# (default 14). Invalid or absent values fall back to the defaults.
# ESCALATION_THRESHOLD_MINUTES=30
# ESCALATION_DOCUMENT_HORIZON_DAYS=14
# Optional. Days before a legal, insurance or audit declaration expires that administrators are
# reminded (default 30). The reminder repeats weekly while the gap persists and re-arms when the
# declaration is re-recorded.
# READINESS_HORIZON_DAYS=30
# Optional cap, in hours, on the response window published on the support page. The window itself
# is derived from recorded on-call coverage, so this cannot create a promise on its own.
# SUPPORT_RESPONSE_HOURS=48
